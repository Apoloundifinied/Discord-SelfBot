# Token da CONTA DE USUÁRIO (selfbot) que vai ler o histórico das mensagens.
DISCORD_TOKEN=

# Supabase
SUPABASE_URL=https://jbcpqnrjuiwurctbefbb.supabase.co
SUPABASE_KEY=
SUPABASE_TABLE=discord_messages

# Canais/servidores a raspar (IDs separados por vírgula).
# CHANNEL_IDS = canais específicos.
# GUILD_IDS   = servidores inteiros (todos os canais de texto legíveis pela conta).
CHANNEL_IDS=
GUILD_IDS=

# Paginação (máximo permitido pelo Discord por request é 100)
MESSAGES_PER_REQUEST=100

# Máximo de mensagens raspadas por canal em CADA execução (0 = sem limite).
# Mantenha um valor razoável e rode o script periodicamente (ex: via cron)
# em vez de tentar raspar um histórico enorme de uma vez só.
MAX_MESSAGES_PER_CHANNEL_PER_RUN=2000

# Atraso (ms) aleatório entre cada página de mensagens buscada (anti-ban).
MIN_DELAY_MS=2500
MAX_DELAY_MS=5500

# Atraso (ms) aleatório entre a troca de canal.
MIN_CHANNEL_DELAY_MS=8000
MAX_CHANNEL_DELAY_MS=15000

# Quantas linhas enviar por chamada de insert ao Supabase.
INSERT_BATCH_SIZE=200

# Tentativas antes de desistir de um canal em caso de erro/rate limit.
MAX_RETRIES=5
