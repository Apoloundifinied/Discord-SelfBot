SUPABASE_URL=https://jbcpqnrjuiwurctbefbb.supabase.co
SUPABASE_KEY=sb_secret_uiQp2C3Npvt0CndM0QheuQ_VUlC_O6z
SUPABASE_TABLE=discord_messages

# Modo recomendado: IDs dos servidores que as contas JÁ participam (separados
# por vírgula). Cada instância só escuta, dentre esta lista, os servidores dos
# quais ela já é membro — nenhuma tentativa de entrar via convite, então não
# há risco de cair no captcha do Discord.
# Ex: GUILD_IDS=123456789012345678,987654321098765432
GUILD_IDS=

# Modo legado/opcional: convite de um servidor para a conta tentar entrar
# automaticamente caso ainda não seja membro. Só é usado se GUILD_IDS estiver
# vazio. Pode exigir resolver um captcha (a lib não resolve sozinha), então
# prefira o modo GUILD_IDS acima sempre que possível.
# Ex: https://discord.gg/algumacoisa  ou apenas o código "algumacoisa"
GUILD_INVITE=

# Opcional: limita a escuta a canais específicos (IDs separados por vírgula).
# Deixe vazio para ouvir todos os canais de texto visíveis no servidor.
CHANNEL_IDS=

# Ignorar mensagens enviadas por bots
IGNORE_BOTS=true

# Anti-ban: usado apenas no modo GUILD_INVITE — cada instância espera um tempo
# aleatório (ms) antes de entrar no servidor, para não parecer um ataque
# coordenado de múltiplas contas.
MIN_JOIN_DELAY_MS=5000
MAX_JOIN_DELAY_MS=20000

# Gerenciamento de processos
# Tempo de espera antes de tentar reiniciar uma instância que caiu por erro
RESTART_DELAY_MS=15000
# Quantas vezes reiniciar automaticamente a mesma conta antes de desistir dela
MAX_RESTARTS_PER_ACCOUNT=3

# Caminho para o arquivo de contas (padrão: fleet/accounts.json)
ACCOUNTS_FILE=
