{
  "name": "discord-message-collector",
  "version": "1.0.0",
  "private": true,
  "description": "Coleta histórica e em tempo real de mensagens Discord para Turso (libsql).",
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "lint": "eslint scraper fleet shared test licenses scripts void.js doctor.js",
    "format": "prettier --write scraper fleet shared test licenses scripts void.js doctor.js",
    "scrape": "node scraper/index.js",
    "get-token": "node scraper/get-token.js",
    "fleet": "node fleet/manager.js",
    "doctor": "node doctor.js",
    "dashboard": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:start": "npm --prefix dashboard run start",
    "license": "node licenses/studio.js",
    "license:init": "node licenses/studio.js init",
    "license:create": "node licenses/studio.js create",
    "key": "node scripts/keygen.js",
    "keys": "node licenses/studio.js list",
    "panel": "node licenses/panel.js",
    "void": "node void.js",
    "start": "node void.js",
    "package:client": "node scripts/package-client.js",
    "package:portable": "node scripts/package-client.js --portable",
    "sell": "node scripts/sell.js",
    "test:client": "node scripts/test-client.js",
    "postinstall": "npm --prefix dashboard install --no-audit --no-fund",
    "check": "npm run lint && npm test && npm run dashboard:build"
  },
  "bin": {
    "void": "void.js"
  },
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@node-rs/argon2": "^2.0.2",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^16.4.5",
    "tree-kill": "^1.2.2",
    "debug": "^4.4.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^2.8.8"
  }
}
